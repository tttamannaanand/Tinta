# Copy this to .env and fill in your own values for local `vercel dev`.
# In production, set these in your Vercel project's Environment Variables
# settings instead - never commit real credentials.
#
# Get both free at https://developer.spotify.com/dashboard
# (Create an app -> Settings -> Client ID / Client Secret)
# Note: as of the Feb-Mar 2026 Spotify Developer Mode changes, the
# account that owns the app must have an active Premium subscription.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
